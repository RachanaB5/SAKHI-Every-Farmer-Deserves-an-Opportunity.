# ─── Database ───────────────────────────────────────────────
# Local dev uses SQLite. For deploy, point at Postgres (Neon/Supabase)
# and run `npm run db:postgres` to generate the Postgres client.
DATABASE_URL="file:./dev.db"

# ─── Auth ───────────────────────────────────────────────────
# 32+ random chars. Signs session cookies, pickup QR tokens and OTP HMACs.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ─── Sign in with Google (optional) ─────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type "Web application") and add this authorised redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# Without both values the "Continue with Google" button explains it isn't set up.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Firebase (web auth + Firestore) ────────────────────────
# Copy the web app settings from Firebase Console → Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDBVz_-GkPU83KcFvyVgpi6iVqt82jjE58"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="sakhi-80e79.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="sakhi-80e79"
NEXT_PUBLIC_FIREBASE_APP_ID="1:104707896325:web:4c54740000c46d4df2986c"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="104707896325"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="sakhi-80e79.firebasestorage.app"
# Server-side Admin SDK. Use either a service-account JSON string or
# GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account file.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID="sakhi-80e79"

# ─── AI (optional) ──────────────────────────────────────────
# Gemini checks harvest photos (what they show, does it match the crop, how
# fresh it looks). Without a key photo checks say "not detectable" and an admin
# looks at the photos; every other AI feature uses its deterministic fallback.
# Keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Tried at once when the main model is rate-limited or overloaded (it has its
# own quota). The free tier allows only a few requests a minute per model;
# enable billing on the key for real use. Empty to turn off.
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
# Per-call timeout before falling back (ms)
AI_TIMEOUT_MS="8000"

# ─── Sakhi speech (optional) ────────────────────────────────
# "browser" (default) uses the browser's Web Speech API. "server" is reserved
# for a self-hosted Indic speech model; it is not implemented yet, so the
# panel falls back to the browser. See docs/assistant-privacy.md.
NEXT_PUBLIC_STT_PROVIDER="browser"
# Sakhi's Kannada voice: run `npm run voice:kannada` once (Python with torch,
# onnx and onnxruntime) to build models/kn-female. Point elsewhere if needed.
KANNADA_VOICE_DIR=""
# Sakhi's Hindi voice: `npm run voice:hindi` builds models/hi-female. Used when
# the device has no natural-sounding Hindi voice of its own.
HINDI_VOICE_DIR=""

# ─── Text messages: phone verification ──────────────────────
# Joining and "Forgot PIN?" text a 6-digit code to prove the mobile number.
#   msg91   India; needs a DLT-approved template with an {otp} variable
#   twilio  any country
#   console no SMS at all: the code is shown on screen (development and
#           clearly-labelled demos only, never a real launch)
# Unset: development behaves like console; production refuses to send.
SMS_PROVIDER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ─── Payments: Razorpay (optional) ──────────────────────────
# With both keys set, checkout takes real payments through Razorpay
# Checkout (UPI, cards, netbanking, wallets) and refunds go back through
# Razorpay. Without them, checkout keeps its labelled simulated payment.
# Free Test Mode keys move no real money: sign up at https://razorpay.com,
# switch the dashboard to Test Mode, then Account & Settings → API Keys →
# Generate Test Key. Live keys (rzp_live_…) need a KYC-verified account.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: places orders even if the buyer closes the tab right after
# paying. Dashboard → Webhooks → Add: URL <public app URL>/api/payments/razorpay/webhook,
# events payment.authorized, payment.captured, payment.failed, order.paid,
# and the same secret here. (Razorpay can't reach localhost; use a tunnel.)
RAZORPAY_WEBHOOK_SECRET=""

# ─── Storage ────────────────────────────────────────────────
# "local" writes to /public/uploads. Swap the driver in lib/storage.ts for cloud.
STORAGE_DRIVER="local"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Scheduler (optional) ───────────────────────────────────
# Lets a cron job call /api/subscriptions/run-due with
# `Authorization: Bearer <CRON_SECRET>`. Admins can always run it from Controls.
CRON_SECRET=""
